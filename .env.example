# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Provider: openai | gemini | groq | mock   (mock needs no key and no internet)
LLM_PROVIDER=openai
LLM_API_KEY=
# OpenAI: gpt-5-mini (main) or gpt-4o-mini (cheaper)
# Gemini: check the current free Flash model in Google AI Studio, e.g. gemini-3.8-flash
# Groq: an open model listed at console.groq.com/docs/models
LLM_MODEL=gpt-5-mini
# Optional
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
